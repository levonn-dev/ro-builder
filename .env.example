# ro-builder environment configuration.
#
# Copy to .env (which is gitignored) and fill in values:
#   task bootstrap:env       ; copies this file to .env if missing
#   task bootstrap           ; full bootstrap including the above
#
# Taskfile.yml loads .env automatically and exposes vars to all subprocesses.

# ----- LLM provider -----
# Generic LLM configuration; main.go knows nothing about specific backends.
# A provider registers under a name (e.g. "anthropic") via init(); set
# LLM_PROVIDER to that name to select it at runtime.

# Provider name. Empty defaults to "anthropic". Registered providers:
#   anthropic; Claude via api.anthropic.com (default)
#   openai   ; OpenAI Chat Completions API, OR any OpenAI-compatible
#               server: LM Studio, llama.cpp, Ollama (/v1), vLLM, Azure
#               OpenAI, OpenRouter. Pick this for local LLMs.
LLM_PROVIDER=anthropic

# API key the provider authenticates with. Required for POST /generate;
# without it the API still serves /score.
# For local OpenAI-compatible servers (LM Studio, llama.cpp) leave empty;
# the Authorization header is omitted when this is unset.
LLM_API_KEY=

# Optional model id (provider-specific default if empty).
# Anthropic default: claude-sonnet-4-6
# OpenAI default:    gpt-4o-mini
# Local servers:     whatever model id the server exposes (LM Studio shows
#                    it in the server tab; Ollama: `ollama list`).
LLM_MODEL=claude-sonnet-4-6

# Optional endpoint override; useful for proxies, local mocks, or
# self-hosted variants. Empty uses the provider's standard endpoint.
# Examples for the openai provider:
#   LM Studio:  LLM_BASE_URL=http://localhost:1234/v1
#   llama.cpp:  LLM_BASE_URL=http://localhost:8080/v1
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1
# LLM_BASE_URL=

# Optional per-call timeout in seconds (default 300 = 5 minutes).
# LLM_TIMEOUT_SECONDS=300

# Optional max completion tokens per turn. Provider default is 4096 if
# unset. Reasoning models (Qwen3, DeepSeek-R1, o-series) spend most of
# this on hidden chain-of-thought; if you see jobs failing with
# `provider_max_tokens` and the LLM logs show finish_reason=length with
# all tokens in reasoning_content, raise this (e.g. 262144) OR disable the
# model's thinking mode.
# LLM_MAX_TOKENS=16384

# ----- API server -----
# Address cmd/api binds. Format: ":port" or "host:port".
ADDR=:8080

# Where cmd/api looks for the calc sidecar (must match the sidecar's PORT).
SIDECAR_URL=http://localhost:7401

# ----- Calc sidecar -----
# Port the Node + jsdom sidecar listens on (calc-sidecar/server.ts).
PORT=7401

# Calc backend selection. rocalc (default) requires vendor/rocalc/.
# Set 'stub' to skip vendor entirely and use the in-process stub
# backend that returns deterministic fiction numbers (CI / non-calc
# development only).
# CALC_BACKEND=rocalc

# Number of worker threads in the sidecar's ShimPool (default 2). Each
# worker holds its own JSDOM + rocalc state; concurrent score requests
# are dispatched across workers, so peak throughput scales with this
# value. Each worker costs ~30-50 MB RAM and pays a ~1.5s cold start
# at boot. Tune up only when telemetry shows requests queueing under
# load.
SIDECAR_WORKERS=2

# ----- Build library (PostgreSQL) -----
# Connection string for the build library. Required; the API refuses to
# start without it. docker-compose and the Helm bundled Postgres default
# to these credentials; override for managed Postgres.
DATABASE_URL=postgres://robuilder:robuilder@localhost:5432/robuilder?sslmode=disable
POSTGRES_USER=robuilder
POSTGRES_PASSWORD=robuilder
POSTGRES_DB=robuilder

# Lease-based job recovery (multi-pod safe). Defaults shown.
GENERATION_LEASE_TTL=90s
GENERATION_LEASE_SWEEP_INTERVAL=30s
# Requeue cap for jobs whose worker died mid-run. 0 disables retry.
GENERATION_MAX_ATTEMPTS=0

# ----- Generation worker pool -----
# Number of goroutines that pull from the generations queue concurrently.
# Each worker occupies one LLM call at a time. Default 1 (serialized).
# Raise only when you have capacity for concurrent LLM requests.
GENERATION_WORKERS=1

# Maximum number of queued + in-flight generations. POST /generate returns
# 429 when this cap is reached.
GENERATION_QUEUE_CAP=16

# Fallback poll cadence for the worker pool when no doorbell signal is
# received (e.g., after a crash recovery). Accepts Go duration strings.
GENERATION_POLL_INTERVAL=5s

# Grace window given to in-flight generations on SIGTERM/SIGINT before the
# process exits. Workers finishing within this window save their output.
GENERATION_SHUTDOWN_TIMEOUT=5m

# Maximum LLM tool-use iterations per generation. The orchestrator returns
# a failure if the LLM hasn't called submit_trajectory within this many
# iterations.
GENERATION_MAX_ITERS=60

# ----- Logging -----
# Log level: debug | info | warn | error (default info).
LOG_LEVEL=info

# Log format: text (human-readable) | json (structured, for log aggregators).
LOG_FORMAT=text
