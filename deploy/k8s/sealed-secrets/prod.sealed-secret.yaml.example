# Template for a prod-cluster sealed secret. Generation is operator-only:
# seal against the prod cluster's controller key (kubeseal --controller-namespace
# kube-system, with kubectl pointed at the prod cluster).
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: ro-builder-env
  namespace: ro-builder
spec:
  encryptedData:
    LLM_API_KEY: AgBPLACEHOLDER==
  template:
    metadata:
      name: ro-builder-env
      namespace: ro-builder
    type: Opaque
