# Placeholder. Run `task tilt:seal` to produce the real
# local.sealed-secret.yaml (gitignored) with your LLM_API_KEY encrypted
# against the docker-desktop cluster's sealed-secrets controller.
#
# The structure below is what the real file will look like; the
# encryptedData blob below is FAKE and will not decrypt.
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: ro-builder-env
  namespace: ro-builder
spec:
  encryptedData:
    LLM_API_KEY: AgBPLACEHOLDER==
  template:
    metadata:
      name: ro-builder-env
      namespace: ro-builder
    type: Opaque
